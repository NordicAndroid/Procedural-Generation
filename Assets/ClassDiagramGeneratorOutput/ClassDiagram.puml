class DiagramFieldModel {
    + Name : string
    + Type : string
    + Visibility : string
}
class DiagramMethodModel {
    + Name : string
    + ReturnType : string
    + Visibility : string
    + Parameters : List<DiagramParameterModel>
}
class DiagramParameterModel {
    + Name : string
    + Type : string
}
